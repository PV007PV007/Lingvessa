generator client {
  provider        = "prisma-client"
  output          = "./generated"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["p1_bootstrap", "public"]
}

model BootstrapFixture {
  id           String @id @db.Uuid
  stableCode   String @map("stable_code") @db.VarChar(64)
  versionCode  String @map("version_code") @db.VarChar(32)
  languageCode String @map("language_code") @db.VarChar(2)
  locale       String @db.VarChar(16)
  sampleText   String @map("sample_text")

  @@unique([stableCode, versionCode], map: "bootstrap_fixture_code_version_key")
  @@map("fixtures")
  @@schema("p1_bootstrap")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model activity_items {
  id                 String               @id @db.Uuid
  language_id        String               @db.Uuid
  lesson_id          String               @db.Uuid
  kind               String               @default("activity")
  activity_type      String
  response_modality  String
  position           Int
  content_entities   content_entities     @relation(fields: [id, language_id, kind], references: [id, language_id, kind], onUpdate: NoAction)
  lessons            lessons              @relation(fields: [lesson_id, language_id], references: [id, language_id], onUpdate: NoAction)
  item_knowledge_map item_knowledge_map[]
  item_outcome_map   item_outcome_map[]

  @@unique([id, language_id])
  @@unique([id, language_id, kind])
  @@unique([lesson_id, position])
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model approvals {
  id                        String           @id @db.Uuid
  target_content_version_id String           @db.Uuid
  target_checksum           String
  target_revision           Int
  gate_type                 String
  reviewer_id               String           @db.Uuid
  decision                  String
  decided_at                DateTime         @default(now()) @db.Timestamptz(6)
  notes                     String
  users                     users            @relation(fields: [reviewer_id], references: [id], onUpdate: NoAction)
  content_versions          content_versions @relation(fields: [target_content_version_id], references: [id], onUpdate: NoAction)

  @@unique([target_content_version_id, target_revision, gate_type, reviewer_id])
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model audit_events {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_id    String?  @db.Uuid
  action      String
  target_id   String?  @db.Uuid
  payload     Json     @default("{}")
  occurred_at DateTime @default(now()) @db.Timestamptz(6)
  users       users?   @relation(fields: [actor_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model auth_rate_windows {
  key_hash   Bytes    @id
  attempts   Int
  expires_at DateTime @db.Timestamptz(6)

  @@index([expires_at], map: "auth_rate_expiry")
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model consents {
  id             String   @id @db.Uuid
  user_id        String   @db.Uuid
  purpose        String
  policy_version String
  granted        Boolean
  recorded_at    DateTime @default(now()) @db.Timestamptz(6)
  users          users    @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([user_id, purpose, recorded_at(sort: Desc), id], map: "consents_owner_purpose_time")
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model content_entities {
