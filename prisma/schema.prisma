  target_entity_id                                                                                       String           @db.Uuid
  target_version_id                                                                                      String           @db.Uuid
  relation                                                                                               String
  content_versions_content_version_refs_source_version_id_language_idTocontent_versions                  content_versions @relation("content_version_refs_source_version_id_language_idTocontent_versions", fields: [source_version_id, language_id], references: [id, language_id], onUpdate: NoAction)
  content_versions_content_version_refs_target_version_id_target_entity_id_language_idTocontent_versions content_versions @relation("content_version_refs_target_version_id_target_entity_id_language_idTocontent_versions", fields: [target_version_id, target_entity_id, language_id], references: [id, entity_id, language_id], onUpdate: NoAction)

  @@id([source_version_id, target_entity_id, relation])
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model content_versions {
  id                                                                                                         String                 @id @db.Uuid
  entity_id                                                                                                  String                 @db.Uuid
  language_id                                                                                                String                 @db.Uuid
  version_code                                                                                               String
  schema_version                                                                                             String
  payload                                                                                                    Json
  checksum                                                                                                   String?                @default(dbgenerated("p2_json_checksum(payload)"))
  status                                                                                                     String                 @default("draft")
  revision                                                                                                   Int                    @default(1)
  source_kind                                                                                                String
  created_by                                                                                                 String                 @db.Uuid
  created_at                                                                                                 DateTime               @default(now()) @db.Timestamptz(6)
  approvals                                                                                                  approvals[]
  content_validations                                                                                        content_validations[]
  content_version_refs_content_version_refs_source_version_id_language_idTocontent_versions                  content_version_refs[] @relation("content_version_refs_source_version_id_language_idTocontent_versions")
  content_version_refs_content_version_refs_target_version_id_target_entity_id_language_idTocontent_versions content_version_refs[] @relation("content_version_refs_target_version_id_target_entity_id_language_idTocontent_versions")
  users                                                                                                      users                  @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  content_entities                                                                                           content_entities       @relation(fields: [entity_id, language_id], references: [id, language_id], onUpdate: NoAction)
  publication_entries                                                                                        publication_entries[]
  translations                                                                                               translations[]

  @@unique([entity_id, version_code])
  @@unique([id, entity_id, language_id])
  @@unique([id, language_id])
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model courses {
