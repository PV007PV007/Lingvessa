/// P3 pinned lesson run. Composite PostgreSQL FKs and transition checks are migration-owned.
model lesson_runs {
  run_kind String @default("lesson")
  review_session_id String? @db.Uuid
  selected_item_id String? @db.Uuid
  superseded_at DateTime? @db.Timestamptz(6)
  id                    String    @id @db.Uuid
  user_id               String    @db.Uuid
  language_profile_id   String    @db.Uuid
  language_id           String    @db.Uuid
  variant_id            String    @db.Uuid
  publication_id        String    @db.Uuid
  publication_checksum  String
  lesson_id             String    @db.Uuid
  content_version_id    String    @db.Uuid
  content_checksum      String
  manifest              Json
  state                 String    @default("active")
  position              Int       @default(0)
  client_sequence       BigInt    @default(0)
  revision              Int       @default(1)
  started_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @db.Timestamptz(6)
  completed_at          DateTime? @db.Timestamptz(6)

  @@unique([id, user_id, language_profile_id, language_id])
  @@index([user_id, language_profile_id, state, updated_at(sort: Desc)], map: "lesson_runs_resume")
