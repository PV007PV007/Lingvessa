  kind             String
  title            String
  variety_scope    String             @default("common")
  activity_items   activity_items?
  languages        languages          @relation(fields: [language_id], references: [id], onUpdate: NoAction)
  content_versions content_versions[]
  courses          courses?
  knowledge_items  knowledge_items?
  lessons          lessons?
  levels           levels?
  modules          modules?
  outcomes         outcomes?

  @@unique([id, language_id])
  @@unique([id, language_id, kind])
  @@unique([language_id, stable_code])
  @@schema("public")
}

model content_validations {
  id                 String           @id @db.Uuid
  content_version_id String           @db.Uuid
  target_checksum    String
  target_revision    Int
  validator_version  String
