  knowledge_items_knowledge_edges_from_id_language_idToknowledge_items knowledge_items @relation("knowledge_edges_from_id_language_idToknowledge_items", fields: [from_id, language_id], references: [id, language_id], onUpdate: NoAction)
  knowledge_items_knowledge_edges_to_id_language_idToknowledge_items   knowledge_items @relation("knowledge_edges_to_id_language_idToknowledge_items", fields: [to_id, language_id], references: [id, language_id], onUpdate: NoAction)
