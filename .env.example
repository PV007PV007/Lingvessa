# Runtime template. Copy to an ignored local file or inject through a secret manager.
LINGVESSA_ENV=local
SERVICE_NAME=api
HOST=127.0.0.1
PORT=3002
# Required for api/worker. Set to your isolated local PostgreSQL URL; no stored password.
# DATABASE_URL=<injected at runtime>
DATABASE_CONNECT_TIMEOUT_MS=1500
AI_ENABLED=false
LEARNER_AI_ENABLED=false
ADMIN_AI_ENABLED=false
AI_MODE=manual
AI_FREE_ONLY=true
PAID_INFERENCE_ENABLED=false
MONTHLY_PAID_BUDGET=0
AI_PROVIDER_ALLOWLIST=
AI_MODEL_ALLOWLIST=
AI_CAPABILITY_QUOTAS={}
