  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-lingvessa_session"
      }
    },
    "schemas": {
      "ReviewStart": {
        "type": "object",
        "properties": {
          "language_profile_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "mode": {
            "default": "recommended",
            "type": "string",
            "enum": [
              "recommended",
              "mistakes",
              "all",
              "words",
              "phrases"
            ]
          },
          "skill": {
            "type": "string",
            "enum": [
              "vocabulary",
              "grammar",
              "listening",
              "speaking",
              "writing",
              "pronunciation"
            ]
          },
          "topic_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "collection_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "cap": {
            "default": 10,
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "language_profile_id",
          "mode",
          "cap"
        ],
        "additionalProperties": false
      },
      "ReviewSkip": {
        "type": "object",
        "properties": {
          "expected_position": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          }
        },
        "required": [
          "expected_position"
        ],
        "additionalProperties": false
      },
      "CollectionCreate": {
        "type": "object",
        "properties": {
          "language_profile_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": [
          "language_profile_id",
          "name"
        ],
        "additionalProperties": false
      },
      "CollectionUpdate": {
        "type": "object",
        "properties": {
          "expected_revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "archived"
            ]
          }
        },
        "required": [
          "expected_revision"
        ],
        "additionalProperties": false
      },
      "CollectionEntry": {
        "type": "object",
        "properties": {
          "knowledge_item_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "content_entity_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "custom_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "translation": {
            "type": "string",
            "maxLength": 2000
          },
          "note": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "additionalProperties": false
      },
      "LearningReset": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "language_profile_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "scope": {
            "type": "string",
            "enum": [
              "lesson",
              "module",
              "language"
            ]
          },
          "target_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "reset_mastery": {
            "default": false,
            "type": "boolean"
          },
          "confirmed": {
            "type": "boolean",
            "const": true
          },
          "confirmation": {
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "language_profile_id",
          "scope",
          "reset_mastery",
          "confirmed"
        ],
        "additionalProperties": false
      }
    }
  }
}
