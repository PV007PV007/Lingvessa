{
  "openapi": "3.1.2",
  "info": {
    "title": "Lingvessa P3 Lesson Engine API",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "login",
        "description": "Rate-limited password login. Requires X-Lingvessa-Client: web; sets a Secure HttpOnly SameSite=Strict host cookie.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session and synchronizer CSRF token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "csrf_token"
                  ],
                  "properties": {
                    "csrf_token": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Revoked"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "getMe",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Session-derived user and settings"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          }
        }
      },
      "patch": {
        "operationId": "updateMe",
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated using optimistic revision"
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/me/language-profiles": {
      "get": {
        "operationId": "listLanguageProfiles",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profiles owned by the session user"
          }
        }
      },
      "post": {
        "operationId": "createLanguageProfile",
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "responses": {
          "201": {
            "description": "Unique user/language profile"
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/me/active-language": {
      "put": {
        "operationId": "switchActiveLanguage",
        "description": "Changes active context only; never mutates language-owned state.",
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "New settings revision"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/catalog": {
      "get": {
        "operationId": "getCatalog",
        "parameters": [
          {
            "name": "language",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "cs"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Active stable publications only; drafts/test/preview excluded"
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/lesson-runs": {
      "post": {
        "operationId": "startLessonRun",
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartLessonRun"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Started or resumed pinned lesson run"
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      },
      "get": {
        "operationId": "listLessonRuns",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "language_profile_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owner-scoped pinned lesson runs"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/lesson-runs/{id}": {
      "get": {
        "operationId": "getLessonRun",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authoritative pinned run and manifest"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/lesson-runs/{id}/attempts": {
      "post": {
        "operationId": "submitLessonAttempt",
        "description": "Client score/correct/mastery fields are rejected. Same attempt ID and semantic payload replays the stored result.",
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttemptCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authoritative attempt result and run state"
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/lesson-runs/{id}/exit": {
      "post": {
        "operationId": "exitLessonRun",
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExitLessonRun"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completed run; unresolved mistakes require explicit acknowledgement"
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-lingvessa_session"
      },
      "csrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token"
      }
    },
    "responses": {
      "Problem": {
        "description": "Safe RFC 9457-style problem",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Login": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "additionalProperties": false
      },
      "SettingsUpdate": {
        "type": "object",
        "required": [
          "timezone",
          "expected_revision"
        ],
        "properties": {
          "timezone": {
            "type": "string",
            "maxLength": 80
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code",
          "detail_safe",
          "correlation_id"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "detail_safe": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string",
            "format": "uuid"
          },
          "field_errors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "code"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "StartLessonRun": {
        "type": "object",
        "required": [
          "language_profile_id",
          "publication_id",
          "lesson_id"
        ],
        "properties": {
          "language_profile_id": {
            "type": "string",
            "format": "uuid"
          },
          "publication_id": {
            "type": "string",
            "format": "uuid"
          },
          "lesson_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "ActivityResponse": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "none"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "kind",
              "option_id"
            ],
            "properties": {
              "kind": {
                "const": "single"
              },
              "option_id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "kind",
              "option_ids"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "set",
                  "order"
                ]
              },
              "option_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "kind",
              "pairs"
            ],
            "properties": {
              "kind": {
                "const": "mapping"
              },
              "pairs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "left",
                    "right"
                  ],
                  "properties": {
                    "left": {
                      "type": "string"
                    },
                    "right": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "kind",
              "text"
            ],
            "properties": {
              "kind": {
                "const": "text"
              },
              "text": {
                "type": "string",
                "maxLength": 4000
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "AttemptCommand": {
        "type": "object",
        "required": [
          "attempt_id",
          "content_version_id",
          "item_id",
          "client_sequence",
          "intent",
          "response",
          "presentation",
          "assistance"
        ],
        "properties": {
          "attempt_id": {
            "type": "string",
            "format": "uuid"
          },
          "content_version_id": {
            "type": "string",
            "format": "uuid"
          },
          "item_id": {
            "type": "string",
            "format": "uuid"
          },
          "client_sequence": {
            "type": "integer",
            "minimum": 1
          },
          "intent": {
            "enum": [
              "submit",
              "reveal",
              "continue"
            ]
          },
          "response": {
            "$ref": "#/components/schemas/ActivityResponse"
          },
          "presentation": {
            "type": "object",
            "required": [
              "seed",
              "order"
            ],
            "properties": {
              "seed": {
                "type": "string"
              },
              "order": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "assistance": {
            "type": "object",
            "required": [
              "hint_count",
              "reveal"
            ],
            "properties": {
              "hint_count": {
                "type": "integer",
                "minimum": 0
              },
              "reveal": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "ExitLessonRun": {
        "type": "object",
        "required": [
          "expected_revision",
          "acknowledge_unresolved"
        ],
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          },
          "acknowledge_unresolved": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
