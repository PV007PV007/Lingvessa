{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": false
  },
  "include": [
    "infra/**/*.ts",
    "apps/api/src/**/*.ts",
    "apps/worker/src/**/*.ts",
    "packages/*/src/**/*.ts"
  ],
  "exclude": [
    "tests",
    "node_modules",
    "dist",
    "**/dist/**"
  ]
}
